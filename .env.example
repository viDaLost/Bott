# Обязательно: токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Кому разрешён доступ (ID через запятую). Пусто — всем.
ALLOWED_USERS=

# Поиск песни по фрагменту текста: https://genius.com/api-clients → Client Access Token
GENIUS_TOKEN=

# Cookies для YouTube/Instagram: cookies.txt, закодированный в base64 (одной строкой)
COOKIES_B64=
# ...или путь к файлу cookies.txt
COOKIES_FILE=

# Прокси для скачивания (если YouTube блокирует IP сервера)
PROXY=

# Лимиты
MAX_FILE_MB=49
MAX_DURATION=10800
MAX_PARALLEL=2

# Файл базы SQLite (кэш file_id и кнопки). Для сохранения между деплоями — на постоянном диске
DB_PATH=data/bott.db

# Свой Local Bot API Server (снимает лимит 50 МБ), например http://127.0.0.1:8081
BOT_API_URL=
